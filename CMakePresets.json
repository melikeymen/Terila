{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug — fast build, full debug info",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "$env{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/cmake/Microsoft/SegmentHeap.cmake",
        "CMAKE_CXX_FLAGS_DEBUG": "/MP /utf-8 /Z7 /Od /RTC1"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release — max runtime performance",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "$env{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/cmake/Microsoft/SegmentHeap.cmake",
        "CMAKE_CXX_FLAGS_RELEASE": "/MP /utf-8 /O2 /arch:AVX2",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/OPT:REF /OPT:ICF /INCREMENTAL:NO"
      }
    },
    {
      "name": "x64-release-embed",
      "displayName": "x64 Release Embed — Release with input/ compiled into the binary",
      "inherits": "x64-release",
      "cacheVariables": {
        "TERILA_EMBED_INPUT": "ON"
      }
    },
    {
      "name": "x64-debug-embed",
      "displayName": "x64 Debug Embed — Debug with input/ compiled into the binary",
      "inherits": "x64-debug",
      "cacheVariables": {
        "TERILA_EMBED_INPUT": "ON"
      }
    },
    {
      "name": "x64-fuzz",
      "displayName": "x64 Fuzz — ASan + libFuzzer (NBT, trf, protocol, chunk)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "TERILA_BUILD_FUZZERS": "ON",
        "TERILA_FUZZ_SANITIZER": "address"
      }
    },
    {
      "name": "x64-fuzz-asan",
      "displayName": "x64 Fuzz — ASan (address sanitizer)",
      "inherits": "x64-fuzz",
      "cacheVariables": {
        "TERILA_FUZZ_SANITIZER": "address"
      }
    },
    {
      "name": "x64-fuzz-tsan",
      "displayName": "x64 Fuzz — TSan (thread sanitizer, needs clang-cl)",
      "inherits": "x64-fuzz",
      "cacheVariables": {
        "TERILA_FUZZ_SANITIZER": "thread"
      }
    },
    {
      "name": "x64-fuzz-ubsan",
      "displayName": "x64 Fuzz — UBSan (undefined behaviour, needs clang-cl)",
      "inherits": "x64-fuzz",
      "cacheVariables": {
        "TERILA_FUZZ_SANITIZER": "undefined"
      }
    },
    {
      "name": "x64-fuzz-nosan",
      "displayName": "x64 Fuzz — no sanitizer",
      "inherits": "x64-fuzz",
      "cacheVariables": {
        "TERILA_FUZZ_SANITIZER": "none"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-release-embed",
      "configurePreset": "x64-release-embed"
    },
    {
      "name": "x64-debug-embed",
      "configurePreset": "x64-debug-embed"
    },
    {
      "name": "x64-fuzz",
      "configurePreset": "x64-fuzz",
      "targets": [ "fuzz_nbt", "fuzz_trf_decode", "fuzz_protocol", "fuzz_chunk" ]
    },
    {
      "name": "x64-fuzz-asan",
      "configurePreset": "x64-fuzz-asan",
      "targets": [ "fuzz_nbt", "fuzz_trf_decode", "fuzz_protocol", "fuzz_chunk" ]
    },
    {
      "name": "x64-fuzz-tsan",
      "configurePreset": "x64-fuzz-tsan",
      "targets": [ "fuzz_nbt", "fuzz_trf_decode", "fuzz_protocol", "fuzz_chunk" ]
    },
    {
      "name": "x64-fuzz-ubsan",
      "configurePreset": "x64-fuzz-ubsan",
      "targets": [ "fuzz_nbt", "fuzz_trf_decode", "fuzz_protocol", "fuzz_chunk" ]
    },
    {
      "name": "x64-fuzz-nosan",
      "configurePreset": "x64-fuzz-nosan",
      "targets": [ "fuzz_nbt", "fuzz_trf_decode", "fuzz_protocol", "fuzz_chunk" ]
    }
  ]
}
